# Eingaben: @file:/absoluter/pfad liest mehrzeilige Schlüssel/Zertifikate.
ALPINE_VERSION=<ALPINE_VERSION=3.24>
DOMAIN=<global.DOMAIN>
NEXTCLOUD_ADMIN_USER=<NEXTCLOUD_ADMIN_USER=admin>
NEXTCLOUD_VERSION=<NEXTCLOUD_VERSION=34-apache>
ONLYOFFICE_VERSION=<ONLYOFFICE_VERSION=9.4.0.1>
PHP_MEMORY_LIMIT=<PHP_MEMORY_LIMIT=1024M>
PHP_UPLOAD_LIMIT=<PHP_UPLOAD_LIMIT=10G>
POSTGRES_DB=<POSTGRES_DB=nextcloud>
POSTGRES_USER=<POSTGRES_USER=nextcloud>
POSTGRES_VERSION=<POSTGRES_VERSION=18>
REDIS_VERSION=<REDIS_VERSION=8-alpine>
POSTGRESQL_PASSWORD=-<postgresql_password | targets=postgresql_password | generate="openssl rand -hex 32">
NEXTCLOUD_ADMIN_PASSWORD=-<nextcloud_admin_password | targets=nextcloud_admin_password | generate="openssl rand -hex 32">
ONLYOFFICE_JWT_SECRET=-<onlyoffice_jwt_secret | targets=onlyoffice_jwt_secret | generate="openssl rand -hex 32">
